# Copy to .env and adjust. Every setting read by src/dockwatch/config.py is listed here with a safe default.

# local = SeaweedFS (S3 API) + Iceberg REST + Trino in Docker; aws = S3 + Glue + Athena
DOCKWATCH_TARGET=local

# GBFS
DOCKWATCH_GBFS_DISCOVERY_URL=https://gbfs.baywheels.com/gbfs/gbfs.json
DOCKWATCH_GBFS_VERSION=2.3
DOCKWATCH_GBFS_LANGUAGE=en
DOCKWATCH_USER_AGENT=dockwatch/0.1 (+https://github.com/braaaeeedyn/dockwatch)

# Kafka (Redpanda)
DOCKWATCH_KAFKA_BOOTSTRAP=localhost:19092

# Raw archive: "s3" (SeaweedFS locally, S3 on aws) or "fs" (a local folder, for quick runs without Docker)
DOCKWATCH_ARCHIVE_KIND=s3
DOCKWATCH_ARCHIVE_FS_ROOT=data/raw
DOCKWATCH_S3_BUCKET=dockwatch
DOCKWATCH_S3_ENDPOINT=http://localhost:8333
DOCKWATCH_S3_REGION=us-west-2
# Local SeaweedFS only (infra/seaweedfs/s3.json). On aws, leave these empty and use an IAM role / profile.
DOCKWATCH_S3_ACCESS_KEY=dockwatch
DOCKWATCH_S3_SECRET_KEY=dockwatch-local-only
